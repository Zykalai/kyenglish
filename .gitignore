# 公开分享仓库：保留可复现的源码与单文件成品；原始大词典、备份、截图不入库
/*
!/index.html
!/requirements.txt
!/.gitattributes
!/.github/
!/deploy/
!/src/
!/tools/
!/data/
!/*.template.html
!/cloudflare_worker.js
!.gitignore

# 66MB 原始 ECDICT 只留在本地，构建产物已在 data/lexicon 中
/data/dict/ecdict.csv

# 离线预处理中间文件（blocks/report/undecided），可由 build.py 重新生成
/data/lexicon/work/

# 旧调试脚本与铃声素材不参与网页构建；只保留组装与词典构建脚本
/tools/*
!/tools/assemble.py
!/tools/lexicon/
!/tools/lexicon/**
/tools/bell_src/

# Python 缓存
__pycache__/
*.pyc
