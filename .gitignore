# 公开分享仓库：保留可复现的源码、单文件成品和完整构建输入；备份、截图不入库
/*
!/index.html
!/README.md
!/requirements.txt
!/.gitattributes
!/.github/
!/deploy/
!/src/
!/tools/
!/data/
!/*.template.html
!/cloudflare_worker.js
!.gitignore

# 旧调试脚本与铃声素材不参与网页构建；只保留组装与词典构建脚本
/tools/*
!/tools/assemble.py
!/tools/lexicon/
!/tools/lexicon/**
/tools/bell_src/

# Python 缓存
__pycache__/
*.pyc
